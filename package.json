{
  "name": "maria-langgraph-pp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Fluxo Pessoa Presa em LangGraph nativo (sem camada de builder visual) — API fina pra ponte Tykhe. Repo de aprendizado/experimentação.",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "dev:pretty": "tsx watch src/server.ts | pino-pretty",
    "start": "node dist/server.js",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "cross-env NODE_ENV=test node --import tsx --test test/*.test.ts"
  },
  "dependencies": {
    "@langchain/aws": "^1.4.4",
    "@langchain/core": "^1.0.7",
    "@langchain/langgraph": "^1.3.7",
    "@langchain/langgraph-checkpoint-postgres": "^1.0.1",
    "dotenv": "^17.4.2",
    "fastify": "^5.2.0",
    "pg": "^8.13.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "cross-env": "^10.1.0",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
